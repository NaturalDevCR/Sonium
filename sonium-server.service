[Unit]
Description=Sonium multiroom audio server
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=sonium
ExecStart=/usr/local/bin/sonium-server --config /etc/sonium/sonium.toml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonium-server

# Minimal privilege footprint
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
# users.json, sonium-state.json and sonium.log live next to the config file.
ReadWritePaths=/etc/sonium /tmp

[Install]
WantedBy=multi-user.target
